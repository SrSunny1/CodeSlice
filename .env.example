# OpenAI 兼容接口地址（也兼容简写 BASE_URL）
# 免费可选项：
#   阿里心流 iFlow（旗舰模型免费）→ BASE_URL=https://apis.iflow.cn/v1，MODEL 可用 DeepSeek-V3.2 / Qwen3-Coder / KIMI-K2
#   智谱 BigModel（官方长期免费）→ BASE_URL=https://open.bigmodel.cn/api/paas/v4，MODEL=glm-4-flash
OPENAI_BASE_URL=https://api.openai.com/v1
# API Key（也兼容 DEEPSEEK_API_KEY / LLM_API_KEY / API_KEY），未配置时需开启 MOCK_LLM 才能体验
OPENAI_API_KEY=
# 模型名（也兼容简写 MODEL）
OPENAI_MODEL=gpt-4o-mini
# 设为 1 时不调用网络，全部接口返回本地模拟数据
MOCK_LLM=1
